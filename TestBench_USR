
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity TB_USR is
end TB_USR;

architecture Behavioral of TB_USR is

    signal CLK : STD_LOGIC := '0';
    signal RST : STD_LOGIC := '0';
    signal S1, S0 : STD_LOGIC;

    signal D : STD_LOGIC_VECTOR(3 downto 0);
    signal SR, SL : STD_LOGIC;

    signal Q : STD_LOGIC_VECTOR(3 downto 0);

begin

    UUT: entity work.USR
        port map (
            CLK => CLK,
            RST => RST,
            S1 => S1,
            S0 => S0,
            D => D,
            SR => SR,
            SL => SL,
            Q => Q
        );

    -- Clock generation
    CLK <= not CLK after 5 ns;

    PROCESS
    begin

        -- Reset
        RST <= '1';
        wait for 10 ns;
        RST <= '0';

        -- Parallel Load
        S1 <= '1'; S0 <= '1';
        D <= "1011";
        wait for 10 ns;

        -- Hold
        S1 <= '0'; S0 <= '0';
        wait for 10 ns;

        -- Shift Right
        S1 <= '0'; S0 <= '1';
        SR <= '0';
        wait for 10 ns;

        -- Shift Left
        S1 <= '1'; S0 <= '0';
        SL <= '1';
        wait for 10 ns;

        wait;

    end process;

end Behavioral;
